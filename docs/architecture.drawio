                <mxCell id="raw" value="Raw archive&#xa;(data/raw)&#xa;&#xa;verbatim copy,&#xa;never modified / deleted" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#64748b;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="-14" y="303" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="ingest" value="ingest  (Go)  :5200&#xa;&#xa;watches drop dir, parses&#xa;CSV rows, archives raw,&#xa;publishes one event per row.&#xa;POST /replay re-emits raw." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#6d28d9;strokeColor=#a78bfa;fontColor=#ede9fe;fontFamily=Helvetica;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="368" y="173" width="210" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="rmq" value="RabbitMQ  :5672&#xa;(mgmt UI :15672)&#xa;&#xa;— message bus, AMQP —&#xa;&#xa;exchanges (fanout):&#xa;• transaction.imported&#xa;• transaction.categorized&#xa;• transaction.categorized.dlx&#xa;&#xa;JSON payloads,&#xa;each carries schema_version" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#c2410c;strokeColor=#fb923c;fontColor=#ffedd5;fontFamily=Helvetica;fontSize=13;verticalAlign=top;spacingTop=12;" parent="1" vertex="1">
                    <mxGeometry x="760" y="150" width="200" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="categorize" value="categorize  (Python / FastAPI)  :5400&#xa;&#xa;consumes transaction.imported,&#xa;applies category rules + resolves&#xa;merchant aliases, then publishes&#xa;transaction.categorized.&#xa;Stateless (no DB)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#6d28d9;strokeColor=#a78bfa;fontColor=#ede9fe;fontFamily=Helvetica;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1160" width="250" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="rules" value="rules  (Python / FastAPI)  :5300&#xa;&#xa;serves category rules,&#xa;merchants &amp; aliases.&#xa;GET /rules · GET /merchants" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#6d28d9;strokeColor=#a78bfa;fontColor=#ede9fe;fontFamily=Helvetica;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1178" y="-204" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="ledger" value=".NET ledger  :5100&#xa;&#xa;consumes transaction.categorized,&#xa;dedupes (hash key) &amp; stores the&#xa;canonical transactions. Owns DB.&#xa;&#xa;HTTP API:&#xa;GET / POST /transactions&#xa;GET /categories&#xa;PATCH /transactions/{id}/category" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#6d28d9;strokeColor=#a78bfa;fontColor=#ede9fe;fontFamily=Helvetica;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1153" y="185" width="270" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="detect" value="detect  (Python / FastAPI)&#xa;&#xa;anomaly / subscription&#xa;detection&#xa;(placeholder — M3+)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#6d28d9;strokeColor=#a78bfa;fontColor=#ede9fe;fontFamily=Helvetica;fontSize=13;dashed=1;opacity=75;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="410" width="210" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="web" value="web  (SvelteKit / adapter-node)  :5173&#xa;&#xa;reads transactions &amp; categories,&#xa;edits manual category overrides.&#xa;The UI." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0d9488;strokeColor=#2dd4bf;fontColor=#99f6e4;fontFamily=Helvetica;fontSize=13;" parent="1" vertex="1">
