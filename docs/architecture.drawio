                <mxCell id="title" value="WYB — System Architecture (services · datastores · integrations)" style="text;html=1;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=light-dark(#E2E8F0,#F5F5F5);verticalAlign=middle;" parent="1" vertex="1">
