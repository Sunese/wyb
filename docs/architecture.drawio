                </mxCell>
                <mxCell id="drop" value="Drop folder&#xa;(data/drop)&#xa;&#xa;user drops bank&#xa;CSV / XLSX here" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#64748b;fontColor=#e2e8f0;fontFamily=Helvetica;fontSize=13;" parent="1" vertex="1">
